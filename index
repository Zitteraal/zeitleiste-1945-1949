                icon: "fa-money-bill-transfer",
                summary: "Einführung der D-Mark in den Westzonen (Trizone) und der Ostmark in der Sowjetzone.",
                description: "Am 20. Juni 1948 führen die Westmächte in der Trizone (Bizone + französische Zone) die 'Deutsche Mark' (DM) ein. Die Schaufenster füllen sich schlagartig mit Waren, die Inflation endet.\n\nDie Sowjetunion wirft dem Westen Bruch des Potsdamer Abkommens vor und führt nur drei Tage später (23. Juni) in der Sowjetischen Besatzungszone (SBZ) eine eigene Währungsreform durch.",
                impact: "Endgültige wirtschaftliche Spaltung Deutschlands in zwei Währungsräume."
            },
            {
                id: 9,
                date: "24. Juni 1948 – 12. Mai 1949",
                title: "Berlin-Blockade & Die Luftbrücke",
                category: "Konflikt",
                categoryColor: "amber",
                icon: "fa-plane-departure",
                summary: "Die UdSSR sperrt alle Zufahrtswege nach West-Berlin. Die Westmächte versorgen die Stadt per Luftbrücke.",
                description: "Um die Einführung der West-Mark in ganz Berlin zu verhindern, blockiert die Sowjetunion alle Land- und Wasserwege nach West-Berlin. Die Stadt ist von Strom und Versorgung abgeschnitten.\n\nDie Westmächte reagieren mit einer beispiellosen Luftbrücke: Über 11 Monate versorgen amerikanische und britische 'Rosinenbomber' im Minutentakt 2,2 Millionen West-Berliner mit Nahrung und Brennstoffen.",
                impact: "Erste große Hülle des Kalten Krieges. West-Berlin wird zum Symbol des Freiheitswillens des Westens."
            },
            {
                id: 10,
                date: "Mai & Oktober 1949",
                title: "Doppelte Staatsgründung (BRD & DDR)",
                category: "Staatsgründung",
                categoryColor: "blue",
                icon: "fa-flag",
                summary: "Mit der Verkündung des Grundgesetzes entsteht die BRD (Mai), gefolgt von der Gründung der DDR (Oktober).",
                description: "Am 12. Mai 1949 gibt die UdSSR die Berlin-Blockade ergebnislos auf. Am 23. Mai 1949 wird in Bonn das Grundgesetz verkündet – die Bundesrepublik Deutschland (BRD) ist gegründet.\n\nAls Reaktion darauf konstituiert sich am 7. Oktober 1949 in Ost-Berlin die Deutsche Demokratische Republik (DDR).",
                impact: "Die formelle und staatliche Teilung Deutschlands in zwei Staaten ist für 40 Jahre besiegelt."
            }
        ];

        let currentFilter = 'all';
        let searchQuery = '';

        // Category Color Mapping Helper
        function getCategoryStyle(category) {
            switch(category) {
                case 'Politik':
                    return { bg: 'bg-red-500/10', text: 'text-red-400', border: 'border-red-500/30', dot: 'bg-red-500' };
                case 'Wirtschaft':
                    return { bg: 'bg-emerald-500/10', text: 'text-emerald-400', border: 'border-emerald-500/30', dot: 'bg-emerald-500' };
                case 'Konflikt':
                    return { bg: 'bg-amber-500/10', text: 'text-amber-400', border: 'border-amber-500/30', dot: 'bg-amber-500' };
                case 'Staatsgründung':
                    return { bg: 'bg-blue-500/10', text: 'text-blue-400', border: 'border-blue-500/30', dot: 'bg-blue-500' };
                default:
                    return { bg: 'bg-brand-500/10', text: 'text-brand-400', border: 'border-brand-500/30', dot: 'bg-brand-500' };
            }
        }

        // Render Timeline
        function renderTimeline() {
            const container = document.getElementById('timelineContainer');
            const noResults = document.getElementById('noResults');
            container.innerHTML = '';

            const filteredEvents = eventsData.filter(event => {
                const matchesFilter = (currentFilter === 'all' || event.category === currentFilter);
                const matchesSearch = event.title.toLowerCase().includes(searchQuery.toLowerCase()) || 
                                      event.summary.toLowerCase().includes(searchQuery.toLowerCase()) ||
                                      event.date.toLowerCase().includes(searchQuery.toLowerCase());
                return matchesFilter && matchesSearch;
            });

            document.getElementById('eventCount').textContent = filteredEvents.length;

            if (filteredEvents.length === 0) {
                noResults.classList.remove('hidden');
                return;
            } else {
                noResults.classList.add('hidden');
            }

            filteredEvents.forEach((item, index) => {
                const isEven = index % 2 === 0;
                const style = getCategoryStyle(item.category);

                const itemHTML = `
                    <div class="relative flex flex-col md:flex-row items-center cursor-pointer group" onclick="openModal(${item.id})">
                        
                        <!-- Timeline Dot Marker -->
                        <div class="absolute left-4 md:left-1/2 -translate-x-1/2 z-20 flex items-center justify-center w-9 h-9 rounded-full ${style.dot} text-slate-950 font-bold shadow-lg shadow-${style.dot}/30 group-hover:scale-125 transition-transform duration-300">
                            <i class="fa-solid ${item.icon} text-sm"></i>
                        </div>

                        <!-- Content Card Left or Right -->
                        <div class="w-full md:w-1/2 pl-12 md:pl-0 ${isEven ? 'md:pr-10 md:text-right' : 'md:pl-10 md:ml-auto'}">
                            <div class="bg-slate-800/80 hover:bg-slate-800 border border-slate-700/70 hover:border-slate-500/60 rounded-2xl p-5 shadow-lg transition-all duration-300 group-hover:-translate-y-1">
                                
                                <div class="flex flex-wrap items-center gap-2 mb-2 ${isEven ? 'md:justify-end' : 'md:justify-start'}">
                                    <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full ${style.bg} ${style.text} ${style.border} border">
                                        ${item.category}
                                    </span>
                                    <span class="text-xs font-bold text-slate-400">
                                        <i class="fa-regular fa-calendar mr-1"></i>${item.date}
                                    </span>
                                </div>

                                <h3 class="text-lg font-bold text-white group-hover:text-brand-400 transition-colors">
                                    ${item.title}
                                </h3>

                                <p class="text-xs text-slate-300 mt-2 line-clamp-2 leading-relaxed">
                                    ${item.summary}
                                </p>

                                <div class="mt-4 flex items-center gap-1 text-xs font-semibold text-brand-400 ${isEven ? 'md:justify-end' : 'md:justify-start'}">
                                    <span>Mehr Details lesen</span>
                                    <i class="fa-solid fa-arrow-right text-[10px] group-hover:translate-x-1 transition-transform"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
                container.insertAdjacentHTML('beforeend', itemHTML);
            });
        }

        // Filter Logic
        function filterEvents(category) {
            currentFilter = category;
            
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.classList.remove('bg-brand-600', 'border-brand-500', 'text-white', 'shadow-sm');
                btn.classList.add('bg-slate-800', 'border-slate-700', 'text-slate-300');
            });

            const activeBtn = document.getElementById(`btn-${category}`);
            if (activeBtn) {
                activeBtn.classList.remove('bg-slate-800', 'border-slate-700', 'text-slate-300');
                activeBtn.classList.add('bg-brand-600', 'border-brand-500', 'text-white', 'shadow-sm');
            }

            renderTimeline();
        }

        // Search Input Listener
        document.getElementById('searchInput').addEventListener('input', (e) => {
            searchQuery = e.target.value;
            renderTimeline();
        });

        // Modal Controls
        function openModal(id) {
            const eventItem = eventsData.find(item => item.id === id);
            if (!eventItem) return;

            document.getElementById('modalTitle').textContent = eventItem.title;
            document.getElementById('modalDate').innerHTML = `<i class="fa-regular fa-calendar"></i> ${eventItem.date}`;
            document.getElementById('modalCategory').textContent = eventItem.category;
            document.getElementById('modalSummary').textContent = `„${eventItem.summary}“`;
            document.getElementById('modalDescription').textContent = eventItem.description;
            document.getElementById('modalImpact').textContent = eventItem.impact;

            const modal = document.getElementById('eventModal');
            const container = document.getElementById('modalContainer');
            
            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                container.classList.remove('scale-95');
                container.classList.add('scale-100');
            }, 10);
            document.body.style.overflow = 'hidden';
        }

        function closeModal() {
            const modal = document.getElementById('eventModal');
            const container = document.getElementById('modalContainer');
            
            modal.classList.add('opacity-0');
            container.classList.remove('scale-100');
            container.classList.add('scale-95');
            
            setTimeout(() => {
                modal.classList.add('hidden');
                document.body.style.overflow = 'auto';
            }, 300);
        }

        // Close Modal when clicking background overlay
        document.getElementById('eventModal').addEventListener('click', (e) => {
            if (e.target.id === 'eventModal') {
                closeModal();
            }
        });

        // Close on Escape key
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeModal();
        });

        // Initial Load
        window.addEventListener('DOMContentLoaded', () => {
            renderTimeline();
        });
    </script>
</body>
</html>
