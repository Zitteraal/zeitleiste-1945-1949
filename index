<!DOCTYPE html>
<html lang="de" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Der Weg in die deutsche Teilung (1945–1949)</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0f7ff',
                            100: '#e0effe',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                            900: '#1e3a8a',
                        },
                        darkbg: '#0f172a',
                        darkcard: '#1e293b',
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        /* Custom scrollbar for webkit */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0f172a;
        }
        ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #475569;
        }
    </style>
</head>
<body class="bg-darkbg text-slate-100 min-h-screen flex flex-col justify-between selection:bg-brand-500 selection:text-white">

    <!-- Header & Navigation -->
    <header class="sticky top-0 z-40 bg-slate-900/90 backdrop-blur-md border-b border-slate-800 shadow-lg">
        <div class="max-w-6xl mx-auto px-4 py-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="p-2.5 bg-brand-600/20 text-brand-500 rounded-xl border border-brand-500/30">
                    <i class="fa-solid font-bold fa-timeline text-2xl"></i>
                </div>
                <div>
                    <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-white">Der Weg in die deutsche Teilung</h1>
                    <p class="text-xs text-slate-400">Historische Ereignisleiste 1945 – 1949</p>
                </div>
            </div>

            <!-- Search & Filter Controls -->
            <div class="w-full md:w-auto flex flex-col sm:flex-row items-center gap-3">
                <div class="relative w-full sm:w-64">
                    <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                    <input type="text" id="searchInput" placeholder="Ereignis suchen..." 
                        class="w-full pl-9 pr-4 py-2 bg-slate-800/80 border border-slate-700 rounded-lg text-sm text-slate-200 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition">
                </div>
            </div>
        </div>

        <!-- Filter Tags Bar -->
        <div class="max-w-6xl mx-auto px-4 pb-3 sm:px-6 lg:px-8 flex items-center gap-2 overflow-x-auto no-scrollbar">
            <span class="text-xs text-slate-400 font-medium mr-1 flex items-center gap-1">
                <i class="fa-solid fa-filter text-xs"></i> Filter:
            </span>
            <button onclick="filterEvents('all')" id="btn-all" class="filter-btn active-filter px-3 py-1 text-xs font-medium rounded-full border transition-all duration-200 bg-brand-600 border-brand-500 text-white shadow-sm">
                Alle
            </button>
            <button onclick="filterEvents('Politik')" id="btn-Politik" class="filter-btn px-3 py-1 text-xs font-medium rounded-full border border-slate-700 bg-slate-800 text-slate-300 hover:bg-slate-700 transition-all duration-200">
                <i class="fa-solid fa-landmark mr-1 text-red-400"></i> Politik
            </button>
            <button onclick="filterEvents('Wirtschaft')" id="btn-Wirtschaft" class="filter-btn px-3 py-1 text-xs font-medium rounded-full border border-slate-700 bg-slate-800 text-slate-300 hover:bg-slate-700 transition-all duration-200">
                <i class="fa-solid fa-coins mr-1 text-emerald-400"></i> Wirtschaft & Währung
            </button>
            <button onclick="filterEvents('Konflikt')" id="btn-Konflikt" class="filter-btn px-3 py-1 text-xs font-medium rounded-full border border-slate-700 bg-slate-800 text-slate-300 hover:bg-slate-700 transition-all duration-200">
                <i class="fa-solid fa-triangle-exclamation mr-1 text-amber-400"></i> Konflikt & Blockade
            </button>
            <button onclick="filterEvents('Staatsgründung')" id="btn-Staatsgründung" class="filter-btn px-3 py-1 text-xs font-medium rounded-full border border-slate-700 bg-slate-800 text-slate-300 hover:bg-slate-700 transition-all duration-200">
                <i class="fa-solid fa-flag mr-1 text-blue-400"></i> Staatsgründung
            </button>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-5xl mx-auto px-4 py-8 sm:px-6 lg:px-8 flex-grow w-full">
        
        <!-- Timeline Hero Stats / Info -->
        <div class="mb-10 bg-slate-800/50 border border-slate-700/60 rounded-2xl p-6 text-center md:text-left flex flex-col md:flex-row items-center justify-between gap-6 shadow-md backdrop-blur-sm">
            <div class="space-y-1">
                <h2 class="text-lg font-semibold text-white">Vom Ende des II. Weltkriegs zur doppelten Staatsgründung</h2>
                <p class="text-sm text-slate-400 max-w-2xl">
                    Klicke auf die einzelnen Ereigniskarten, um erweiterte historische Hintergründe, Zusammenhänge und Quellenhinweise zu erfahren.
                </p>
            </div>
            <div class="flex items-center gap-4 bg-slate-900/80 px-4 py-3 rounded-xl border border-slate-700/50">
                <div class="text-center">
                    <span class="block text-xl font-bold text-brand-500" id="eventCount">0</span>
                    <span class="text-[10px] uppercase tracking-wider text-slate-400 font-semibold">Ereignisse</span>
                </div>
                <div class="h-8 w-px bg-slate-700"></div>
                <div class="text-center">
                    <span class="block text-xl font-bold text-amber-400">4 Jahre</span>
                    <span class="text-[10px] uppercase tracking-wider text-slate-400 font-semibold">Zeitraum</span>
                </div>
            </div>
        </div>

        <!-- Interactive Timeline Vertical Section -->
        <div class="relative wrap overflow-hidden p-2 md:p-6">
            <!-- Central Line with Dynamic Progress Gradient -->
            <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-1 bg-slate-800 -translate-x-1/2 rounded-full">
                <div id="timelineProgress" class="w-full bg-gradient-to-b from-brand-500 via-indigo-500 to-emerald-400 transition-all duration-300" style="height: 100%;"></div>
            </div>

            <!-- Timeline Events Container -->
            <div id="timelineContainer" class="space-y-8 relative">
                <!-- Javascript will render timeline items here -->
            </div>
        </div>

        <!-- Empty Search Result -->
        <div id="noResults" class="hidden text-center py-16">
            <div class="w-16 h-16 bg-slate-800 rounded-full flex items-center justify-center mx-auto mb-4 text-slate-500 text-2xl">
                <i class="fa-solid fa-ghost"></i>
            </div>
            <h3 class="text-lg font-medium text-slate-300">Keine Ereignisse gefunden</h3>
            <p class="text-sm text-slate-500 mt-1">Versuche einen anderen Suchbegriff oder passe die Filter an.</p>
        </div>
    </main>

    <!-- Modal for Detailed View -->
    <div id="eventModal" class="fixed inset-0 z-50 hidden bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4 opacity-0 transition-opacity duration-300">
        <div class="bg-slate-900 border border-slate-700 rounded-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto shadow-2xl flex flex-col transform scale-95 transition-transform duration-300" id="modalContainer">
            <!-- Modal Header -->
            <div class="p-6 border-b border-slate-800 flex justify-between items-start sticky top-0 bg-slate-900/95 backdrop-blur z-10">
                <div>
                    <span id="modalCategory" class="inline-block px-2.5 py-0.5 text-xs font-semibold rounded-full bg-brand-500/20 text-brand-400 border border-brand-500/30 mb-2"></span>
                    <h3 id="modalTitle" class="text-xl sm:text-2xl font-bold text-white"></h3>
                    <p id="modalDate" class="text-sm text-brand-400 font-medium mt-1 flex items-center gap-1.5"></p>
                </div>
                <button onclick="closeModal()" class="p-2 text-slate-400 hover:text-white bg-slate-800 hover:bg-slate-700 rounded-lg transition">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            
            <!-- Modal Body -->
            <div class="p-6 space-y-4 text-slate-300 text-sm leading-relaxed">
                <div class="bg-slate-800/60 p-4 rounded-xl border border-slate-700/50 text-slate-200 italic" id="modalSummary"></div>
                
                <div>
                    <h4 class="text-xs uppercase tracking-wider font-semibold text-slate-400 mb-2">Ausführliche Beschreibung & Kontext</h4>
                    <p id="modalDescription" class="whitespace-pre-line text-slate-300"></p>
                </div>

                <div id="modalImpactContainer" class="bg-slate-800/40 border border-slate-700/40 p-4 rounded-xl">
                    <h4 class="text-xs uppercase tracking-wider font-semibold text-amber-400 mb-1 flex items-center gap-1">
                        <i class="fa-solid fa-circle-exclamation"></i> Bedeutung für die Teilung
                    </h4>
                    <p id="modalImpact" class="text-slate-300"></p>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="p-4 border-t border-slate-800 bg-slate-900/50 flex justify-end">
                <button onclick="closeModal()" class="px-5 py-2 bg-slate-800 hover:bg-slate-700 text-white rounded-lg text-sm font-medium transition">
                    Schließen
                </button>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-slate-900 border-t border-slate-800 py-6 text-center text-xs text-slate-500 mt-12">
        <div class="max-w-6xl mx-auto px-4 space-y-2">
            <p>Interaktiver Geschichts-Zeitstrahl: Schulbuch-Zusammenfassung (1945–1949)</p>
            <p class="text-slate-600">Erstellt für das Fach Geschichte • Frei hostbar via GitHub Pages, Vercel & Netlify</p>
        </div>
    </footer>

    <!-- JavaScript Data and App Logic -->
    <script>
        // Array holding all historical events based on provided textbook context
        const eventsData = [
            {
